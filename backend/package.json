{
  "name": "ecoquest-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "db:seed": "node scripts/db/seed.js",
    "db:setup": "prisma migrate dev --schema ../database/prisma/schema.prisma --name init && node scripts/db/seed.js",
    "test": "node --test"
  },
  "prisma": {
    "seed": "node scripts/db/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
