# Copy to backend/.env. Never commit real secrets.
DATABASE_URL=postgresql://ecoquest@127.0.0.1:5433/ecoquest
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development

# Optional. Leave blank to store evidence images on the API machine.
# Ask the project owner for these; do not invent them.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required in production for password recovery emails. Development returns a local reset link.
RESEND_API_KEY=
MAIL_FROM=
